server:
  # enabled (optional, defaults to true): gates the REST/JSON Le adapter.
  # Independent of mlp.enabled below — both, either, or neither may run;
  # at least one must be true.
  # enabled: true
  listen_address: "127.0.0.1:8086"
  shutdown_timeout: "10s"
mlp:
  # MLP is the OMA Mobile Location Protocol Le adapter (internal/mlp) ▒~@~T the
  # actual standards-based interface the REST/JSON API above stands in for.
  # It is a second, independent HTTP listener, not a replacement for the
  # REST one (see server.enabled above). Disabled by default. Currently
  # implements Standard Location Immediate Service (slir/slia) only ▒~@~T see
  # docs/mlp-le-interface-plan.md for phased scope.
  enabled: false
  # 9210/tcp is the IANA-registered port for unencrypted MLP ("lif-mlp").
  listen_address: "0.0.0.0:9210"
  # How long a slir blocks waiting for every target to reach a terminal
  # state when the client's own eqop/resp_timer doesn't say otherwise.
  sync_wait_timeout: "20s"
  # The most a client's own resp_timer may extend that wait to ▒~@~T a client
  # can shorten the wait, never lengthen it past this.
  max_sync_wait_timeout: "60s"
  shutdown_timeout: "10s"
mlp_reporting:
  # mlp_reporting pushes unsolicited MLP reports (slrep for MO-LR, emerep
  # for emergency call origination/release/handover) to a fixed,
  # operator-configured LCS Client URL per report type, triggered by
  # internal/lrr on qualifying inbound LRRs. Requires lrr.enabled above.
  # There's no per-subscriber routing in MLP for a report nothing
  # requested, so this is one destination per report type, not a table.
  enabled: false
  # standard_report_url/standard_report_client_id: both required together
  # if set. Leave both empty to skip pushing slrep even if enabled: true.
  standard_report_url: ""
  standard_report_client_id: ""
  # emergency_report_url/emergency_report_client_id: same, for emerep.
  emergency_report_url: ""
  emergency_report_client_id: ""
  timeout: "10s"
database:
  path: "/var/lib/vectorcore/gmlc/gmlc.db"
  busy_timeout: "5s"
  synchronous: "FULL" # FULL, NORMAL, or OFF
  checkpoint_pages: 1000
retention:
  request: "720h"
  result: "168h"
  purge_interval: "1h" # optional; defaults to 1h if unset
logging:
  file: "/var/log/vectorcore/gmlc.log"
  level: "info"
diameter:
  # Diameter is mandatory. Peer capabilities are negotiated from CEA.
  origin_host: "gmlc.epc.mnc435.mcc311.3gppnetwork.org"
  origin_realm: "epc.mnc435.mcc311.3gppnetwork.org"
  host_ip_address: "127.0.0.1"
  # hss_realm/hss_host: where SLh Routing-Info-Requests are sent. Both are
  # optional; hss_realm defaults to origin_realm (same-operator deployments
  # where the GMLC and HSS share a realm). Set them explicitly for
  # cross-realm/interconnect HSS routing.
  # hss_realm: "epc.mnc435.mcc311.3gppnetwork.org"
  # hss_host: "hss.epc.mnc435.mcc311.3gppnetwork.org"
  connection_timeout: "5s"
  request_timeout: "5s"
  reconnect_min: "1s"
  reconnect_max: "30s"
  watchdog_interval: "5s"
  watchdog_timeout: "5s"
  shutdown_timeout: "10s"
  peers:
    - name: "peer-1"
      address: "127.0.0.1:3868"
      transport: "tcp"
    - name: "peer-2"
      address: "127.0.0.1:3869"
      transport: "sctp"
clients:
  # The token is read only at bootstrap and stored as a SHA-256 hash. Supply it
  # from protected deployment configuration, never source control.
  - id: "example-lcs-client"
    bearer_token: "replace-with-a-long-random-token"
    services: ["immediate"]
    target_prefixes: ["001", "311435"]
    # lcs_client_type (TS 29.172 LCS-Client-Type, operator-set only — never
    # exposed via the REST API): emergency_services, value_added_services
    # (default), plmn_operator_services, lawful_intercept_services.
    # emergency_services/lawful_intercept_services carry regulatory weight
    # downstream at the MME/HSS; only assign them to clients you trust for
    # that purpose.
    lcs_client_type: "value_added_services"
    # lcs_privacy_check (TS 29.172 LCS-Privacy-Check, operator-set only —
    # never exposed via the REST API): allowed_without_notification
    # (default), allowed_with_notification, allowed_if_no_response,
    # restricted_if_no_response, not_allowed. Governs whether/how the
    # target subscriber is notified or consulted before disclosure — this
    # protects the subscriber, not the requesting client, so it must never
    # be settable by the caller.
    lcs_privacy_check: "allowed_without_notification"
delivery:
  # Delivery is optional; enable it once something needs to consume it (LRR
  # deferred reports, REST async-completion callbacks). Both are outbound
  # webhook POSTs signed with HMAC-SHA256 (X-GMLC-Signature: sha256=<hex>).
  enabled: false
  max_attempts: 5
  retry_backoff_min: "1s"
  retry_backoff_max: "5m"
  request_timeout: "10s"
  # encryption_key: 32 bytes, hex-encoded (64 hex characters), used to
  # encrypt callback secrets at rest (AES-256-GCM). Generate with e.g.
  # `openssl rand -hex 32`. Supply from protected deployment configuration,
  # never source control. Required only if enabled is true.
  encryption_key: "replace-with-64-hex-characters-32-random-bytes-aes256key"
lrr:
  # LRR is optional; enable it to decode/answer inbound TS 29.172
  # Location-Report-Request. There is no separate inbound listener — an LRR
  # arrives on the same connection this GMLC dialed out to its DRA/peers on.
  # Disabled by default: without it, an unexpected LRR is silently dropped
  # by the existing answer-only handling, same as before this was added.
  enabled: false
